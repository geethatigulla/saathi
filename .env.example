# Copy this file to .env for local runs. On Vercel, add the same names under Project Settings > Environment Variables.
# Keys stay on the server and are never sent to the browser.

# --- Option A (default): OpenAI. Key from https://platform.openai.com/api-keys ---
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Option B (free tier): Google Gemini. Get a key at https://aistudio.google.com (Get API key). ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Optional: force a provider (openai or gemini).
# AI_PROVIDER=openai

# Optional: soft limits per server instance.
# RATE_PER_IP_HOUR=150
# DAILY_CALL_CAP=3000

# Optional: only accept API calls from your own site, e.g. https://saathi-demo.vercel.app
# ALLOWED_ORIGIN=

# Set to 1 to run with canned AI replies and no key (for testing the flow).
MOCK_AI=0
